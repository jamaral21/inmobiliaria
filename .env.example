# Public canonical origin. Replace with the deployed site's HTTPS URL.
SITE_URL=http://localhost:3000

# Keep false for all previews and local work; set true only for production.
INDEXABLE=false

# Set true on a shared preview and provide both values through Secret Manager.
PREVIEW_AUTH_ENABLED=false
PREVIEW_USERNAME=demo-reviewer
PREVIEW_PASSWORD=replace-with-a-long-random-secret

# Local PostgreSQL from docker-compose.yml. Development-only credentials.
DATABASE_URL=postgresql://habita:habita_dev_local_only@127.0.0.1:55432/habita_dev?schema=public
